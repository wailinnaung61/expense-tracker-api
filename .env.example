# Copy to .env and fill in real values:
#   copy .env.example .env

# Docker Hub (required for compose image name + push)
# Create account: https://hub.docker.com  → use your username here
DOCKERHUB_USER=your-dockerhub-username
IMAGE_TAG=latest

# Database
DB_USER=postgres
DB_PASSWORD=admin

# AWS (Cognito / S3 still use AWS even when API runs locally)
AWS_REGION=us-east-1
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Cognito
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# S3 (optional for local)
S3_EXPORT_BUCKET=

# OpenAI (optional — chat features)
OPENAI_API_KEY=

# Export: Local = API builds Excel + S3 + DB (no Lambda). Production = EventBridge → Lambda.
EXPORT_MODE=Local

# Docker Hub
DOCKERHUB_USER=
IMAGE_TAG=